<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nova.browser">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Declared so WebView pages can request them (camera/mic/location).
         They are only ever requested after a page asks, and the user can
         deny them; the browser never requests them on its own. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Browser"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaBrowser"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- singleTask: a browser has ONE main activity. Without it the
             "New tab" launcher shortcut (and a link opened while the app
             is alive) created a second MainActivity with a second
             BrowserState, a second tab restore and a second set of
             WebViews. Intents now arrive via onNewIntent instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open http(s) links with NOVA Browser (no App Links
                 verification — the user picks the browser explicitly). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Share a link/text to NOVA Browser. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Launcher shortcuts: New tab / New private tab. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Private browsing runs in its own process so its WebView data
             (cookies, cache, storage) lives in a separate directory and
             can be wiped without touching normal tabs. Its own task (and
             no recents entry) keeps the private session separate from the
             normal one — switching between them never destroys either.
             singleTask is load-bearing: without it a second "New private
             tab" created a second instance in the SAME process, which
             called setDataDirectorySuffix("incognito") again after
             WebViews existed and wiped the live data directory. -->
        <activity
            android:name=".PrivateActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":incognito"
            android:taskAffinity="com.nova.browser.incognito"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nova.browser.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
